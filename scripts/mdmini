#!/usr/bin/env bash
# CLI wrapper for md-mini
APP="/Applications/md-mini.app"
BIN="$APP/Contents/MacOS/md-mini"
SOCK="/tmp/com_md_mini_app_si.sock"
PENDING="/tmp/md-mini-pending-files"
CMD_SOCK="/tmp/md_mini_cmd.sock"

# AI interface: `mdmini show <file> ...` / `mdmini edit <file> ...` talk to the
# running app's command socket instead of the file-open path above. Launch the
# app first (no pending files needed — the request itself carries the file)
# if the command socket isn't there yet, then hand off to the binary's own
# `ai` client (see `run_ai_cli` in src-tauri/src/ai_socket.rs). stdin passes
# through untouched for `edit`.
if [ "$1" = "show" ] || [ "$1" = "edit" ]; then
  if [ ! -S "$CMD_SOCK" ]; then
    open "$APP"
    waited=0
    while [ ! -S "$CMD_SOCK" ]; do
      sleep 0.1
      waited=$((waited + 1))
      if [ "$waited" -ge 50 ]; then
        echo '{"ok":false,"error":"md-mini did not start in time"}'
        exit 2
      fi
    done
  fi
  exec "$BIN" ai "$@"
fi

# Resolve relative paths to absolute
args=()
for arg in "$@"; do
  if [[ "$arg" != -* && "$arg" != /* ]]; then
    arg="$(cd "$(dirname "$arg")" 2>/dev/null && pwd)/$(basename "$arg")"
  fi
  args+=("$arg")
done

if [ -S "$SOCK" ]; then
  # App is running (socket exists) — send files via single-instance IPC
  # Second instance connects, sends argv, exits instantly (no blocking)
  "$BIN" "${args[@]}" 2>/dev/null
else
  # App not running — write pending files, launch via open
  if [ ${#args[@]} -gt 0 ]; then
    printf '%s\n' "${args[@]}" > "$PENDING"
  fi
  open "$APP"
fi
